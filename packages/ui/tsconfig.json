{
  "extends": "@v1/typescript/react-library.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },
    "module": "ESNext",
    "moduleResolution": "NodeNext",
    "types": ["vitest/globals", "@testing-library/jest-dom"]
  },
  "include": ["src", "src/**/*"],
  "exclude": ["node_modules"]
}
