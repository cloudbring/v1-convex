{
  "name": "v1",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*",
    "tooling/*"
  ],
  "scripts": {
    "build": "turbo build",
    "clean": "git clean -xdf node_modules",
    "clean:workspaces": "turbo clean",
    "dev": "turbo dev --parallel",
    "dev:web": "turbo dev --filter=@v1/web",
    "dev:jobs": "turbo jobs --filter=@v1/jobs",
    "dev:app": "turbo dev --filter=@v1/app",
    "start:web": "turbo start --filter=@v1/web",
    "start:app": "turbo start --filter=@v1/app",
    "test": "vitest",
    "test:run": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:storybook": "vitest run --project storybook",
    "test:bdd": "vitest run --config vitest.bdd.config.ts",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "storybook": "storybook dev -p 6006",
    "build:storybook": "storybook build",
    "test:storybook:legacy": "test-storybook",
    "test:all": "turbo run test:coverage --parallel && bun run test:e2e",
    "test:smoke": "playwright test tests/smoke",
    "test:ci": "turbo run test:coverage --parallel && bun run test:e2e",
    "format": "biome format --write .",
    "lint": "turbo lint && bun lint:repo",
    "lint:repo": "bunx sherif@latest",
    "lint:repo:fix": "bunx sherif@latest --fix",
    "typecheck": "turbo typecheck"
  },
  "devDependencies": {
    "@amiceli/vitest-cucumber": "^5.1.2",
    "@biomejs/biome": "1.8.3",
    "@faker-js/faker": "^9.0.3",
    "@playwright/test": "^1.48.0",
    "@storybook/addon-a11y": "^9.1.3",
    "@storybook/addon-coverage": "^2.0.0",
    "@storybook/addon-vitest": "^9.1.3",
    "@storybook/react-vite": "^9.1.3",
    "@storybook/test": "^8.6.14",
    "@storybook/test-runner": "^0.23.0",
    "@t3-oss/env-nextjs": "^0.11.1",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^20.16.10",
    "@vitejs/plugin-react": "^4.3.2",
    "@vitest/browser": "^3.2.4",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^2.1.2",
    "chalk": "^4.1.2",
    "convex-test": "^0.0.30",
    "dotenv": "^16.4.5",
    "jsdom": "^25.0.1",
    "nyc": "^17.1.0",
    "ora": "^5.4.1",
    "playwright": "^1.55.0",
    "storybook": "^9.1.3",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.1",
    "turbo": "^2.5.6",
    "typescript": "^5.5.4",
    "vitest": "^3.2.4"
  },
  "packageManager": "bun@1.1.26",
  "dependencies": {
    "@auth/core": "0.37.0"
  },
  "version": "0.0.1",
  "trustedDependencies": [
    "@biomejs/biome",
    "@sentry/cli",
    "@swc/core"
  ]
}
